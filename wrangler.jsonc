{
  "name": "hclc-marketing-report-analysis",
  "compatibility_date": "2026-11-23",
  "main": "worker.mjs",
  "keep_vars": true,
  "triggers": {
    "crons": ["0 */4 * * *"]
  },
  "d1_databases": [
    {
      "binding": "ZETPY_REPORT_DB",
      "database_name": "hclc-zetpy-weekly",
      "database_id": "cf664ebc-b2db-4997-a422-54090bbfa70e",
      "migrations_dir": "."
    }
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/zetpy/*"]
  },
  "vars": {
    "FIREBASE_WEB_API_KEY": "AIzaSyBn9oAAghWLv2X_OnrL-J2Eh4fm90gdhAA"
  }
}
